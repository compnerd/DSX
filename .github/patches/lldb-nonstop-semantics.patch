@@ -5,6 +7,45 @@ import gdbremote_testcase
 
 
 class LldbGdbServerTestCase(gdbremote_testcase.GdbRemoteTestCaseBase):
+    def stopped_threads(self, query=b"?"):
+        threads = set()
+        while True:
+            self._server.send_packet(query)
+            reply = self._server.get_normal_packet()
+            if reply == b"OK":
+                return threads
+            match = re.match(rb"T[0-9a-fA-F]{2}thread:([0-9a-fA-F]+);", reply)
+            self.assertIsNotNone(match, reply)
+            threads.add(match[1])
+            query = b"vStopped"
+
+    def prepare_stopped_threads(self):
+        self.build()
+        self.set_inferior_startup_launch()
+        self.prep_debug_monitor_and_inferior(
+            inferior_args=["thread:new", "stop", "sleep:15"]
+        )
+        self.test_sequence.add_log_lines(
+            [
+                "read packet: $QNonStop:1#00",
+                "send packet: $OK#00",
+                "read packet: $c#63",
+                "send packet: $OK#00",
+                {"direction": "send", "regex": r"^%Stop:T"},
+            ],
+            True,
+        )
+        self.expect_gdbremote_sequence()
+        self.stopped_threads(b"vStopped")
+        # Non-stop mode leaves the other thread running. Stop it explicitly.
+        self._server.send_packet(b"vCont;t")
+        self.assertEqual(self._server.get_normal_packet(), b"OK")
+        self.assertTrue(self._server.get_normal_packet().startswith(b"Stop:T"))
+        self.stopped_threads(b"vStopped")
+        threads = self.stopped_threads()
+        self.assertEqual(len(threads), 2)
+        return sorted(threads)
+
