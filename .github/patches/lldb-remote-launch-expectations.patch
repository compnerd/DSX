diff --git a/lldb/test/API/windows/debug-heap/TestWindowsDebugHeap.py b/lldb/test/API/windows/debug-heap/TestWindowsDebugHeap.py
--- a/lldb/test/API/windows/debug-heap/TestWindowsDebugHeap.py
+++ b/lldb/test/API/windows/debug-heap/TestWindowsDebugHeap.py
@@ -27,6 +27,10 @@ class DebugHeapTestCase(TestBase):
         return process.GetSTDOUT(256)
 
     def test_default(self):
+        if lldb.remote_platform:
+            # PlatformWindows::DebugProcess forwards remote launches before
+            # applying disable-debug-heap to the launch environment.
+            self.skipTest("LLDB does not forward the debug-heap setting")
         output = self._run_to_exit()
         self.assertIn("_NO_DEBUG_HEAP=1", output)
         output = self._run_to_exit(["_NO_DEBUG_HEAP=2"])
@@ -40,6 +44,10 @@ class DebugHeapTestCase(TestBase):
         self.assertIn("_NO_DEBUG_HEAP=2", output)
 
     def test_enabled(self):
+        if lldb.remote_platform:
+            # The remote launch path does not inject _NO_DEBUG_HEAP.
+            # Explicit environment forwarding remains covered by test_disabled.
+            self.skipTest("LLDB does not forward the debug-heap setting")
         self.runCmd("settings set platform.plugin.windows.disable-debug-heap true")
         output = self._run_to_exit()
         self.assertIn("_NO_DEBUG_HEAP=1", output)
