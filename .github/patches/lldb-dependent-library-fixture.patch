diff --git a/lldb/test/API/commands/target/create-deps/Makefile b/lldb/test/API/commands/target/create-deps/Makefile
--- a/lldb/test/API/commands/target/create-deps/Makefile
+++ b/lldb/test/API/commands/target/create-deps/Makefile
@@ -5,6 +5,14 @@
 
 include Makefile.rules
 
-libload_a:
+libload_a: libload_b
 	"$(MAKE)" -f $(MAKEFILE_RULES) \
-		DYLIB_ONLY=YES DYLIB_NAME=load_a DYLIB_CXX_SOURCES=a.cpp
+		DYLIB_ONLY=YES DYLIB_NAME=load_a DYLIB_CXX_SOURCES=a.cpp \
+		LD_EXTRAS="-L. -lload_b"
+
+# A real fixture dependency works even when system libraries only exist in
+# the target's shared cache and cannot be loaded before process launch.
+libload_b:
+	"$(MAKE)" -f $(MAKEFILE_RULES) \
+		DYLIB_ONLY=YES DYLIB_NAME=load_b DYLIB_CXX_SOURCES=b.cpp \
+		DYLIB_INSTALL_NAME="$(BUILDDIR)/libload_b.dylib"
