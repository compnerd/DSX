+    def resume_processes(self, command):
+        identifiers = self.start_fork_test(["fork", "stop"])
+        processes = dict(zip(identifiers[::2], identifiers[1::2]))
+        self._server.send_packet(command.format(*identifiers).encode())
+        reply = self._server.get_normal_packet()
+        match = re.match(rb"T02thread:p([0-9a-f]+)\.([0-9a-f]+);", reply)
+        self.assertIsNotNone(match, reply)
+        first = match[1].decode()
+        self.assertIn(first, processes)
+        self.assertEqual(match[2].decode(), processes[first])
+
+        # Both processes must remain controllable after a multi-process resume.
+        other = next(pid for pid in processes if pid != first)
+        command = f"vCont;c:p{other}.{processes[other]}"
+        self._server.send_packet(command.encode())
+        reply = self._server.get_normal_packet()
+        self.assertTrue(reply.startswith(f"T02thread:p{other}.".encode()),
+                        reply)
+        for pid, tid in processes.items():
+            self._server.send_packet(f"vCont;c:p{pid}.{tid}".encode())
+            self.assertEqual(self._server.get_normal_packet(),
+                             f"W00;process:{pid}".encode())
 
