diff --git a/lldb/test/API/commands/watchpoints/watchpoint_count/TestWatchpointCount.py b/lldb/test/API/commands/watchpoints/watchpoint_count/TestWatchpointCount.py
--- a/lldb/test/API/commands/watchpoints/watchpoint_count/TestWatchpointCount.py
+++ b/lldb/test/API/commands/watchpoints/watchpoint_count/TestWatchpointCount.py
@@ -32,6 +32,11 @@ class TestWatchpointCount(TestBase):
         if not error.Success():
             self.fail("Failed to make watchpoint for x1: %s" % (error.GetCString()))
 
+        capacity = process.GetNumSupportedHardwareWatchpoints(error)
+        self.assertSuccess(error)
+        self.assertGreater(capacity, 0)
+        if capacity == 1:
+            return self.single(process, thread, second_var, first_watch)
         second_watch = second_var.Watch(True, False, True, error)
         if not error.Success():
             self.fail("Failed to make watchpoint for x2: %s" % (error.GetCString()))
@@ -53,3 +58,24 @@ class TestWatchpointCount(TestBase):
         )
         stop_reason_descr = thread.stop_description
         self.assertEqual(stop_reason_descr, "watchpoint 2")
+
+    def single(self, process, thread, second, first):
+        error = lldb.SBError()
+        unavailable = second.Watch(True, False, True, error)
+        self.assertTrue(error.Fail(), "a full hardware bank must reject insertion")
+        self.assertFalse(unavailable.IsValid())
+        process.Continue()
+        self.assertStopReason(thread.GetStopReason(), lldb.eStopReasonWatchpoint)
+        self.assertEqual(thread.stop_description, "watchpoint 1")
+        self.assertTrue(process.GetTarget().DeleteWatchpoint(first.GetID()))
+
+        # Reuse the available slot and still exercise the second access. A
+        # single-slot machine must not silently accept an uninstalled point.
+        watchpoint = second.Watch(True, False, True, error)
+        self.assertSuccess(error)
+        self.assertTrue(watchpoint.IsValid())
+        process.Continue()
+        self.assertStopReason(thread.GetStopReason(), lldb.eStopReasonWatchpoint)
+        self.assertEqual(
+            thread.stop_description, "watchpoint %d" % watchpoint.GetID()
+        )
