+Status PlatformWindows::GetFile(const FileSpec &source,
+                               const FileSpec &destination) {
+  if (!m_remote_platform_sp)
+    return Platform::GetFile(source, destination);
+
+  Status error;
+  auto fd = OpenFile(source, File::eOpenOptionReadOnly,
+                     lldb::eFilePermissionsFileDefault, error);
+  if (error.Fail())
+    return error;
+  auto close = llvm::scope_exit([&] {
+    Status ignored;
+    CloseFile(fd, ignored);
+  });
+
+  uint32_t permissions = 0;
+  if (GetFilePermissions(source, permissions).Fail() || permissions == 0)
+    permissions = lldb::eFilePermissionsFileDefault;
+  auto file = FileSystem::Instance().Open(
+      destination, File::eOpenOptionWriteOnly | File::eOpenOptionCanCreate |
+                       File::eOpenOptionTruncate,
+      permissions);
+  if (!file)
+    return Status::FromError(file.takeError());
+
+  char buffer[4096];
+  uint64_t offset = 0;
+  while (true) {
+    uint64_t count = ReadFile(fd, offset, buffer, sizeof(buffer), error);
+    if (error.Fail())
+      return error;
+    if (count == 0)
+      break;
+    size_t written = 0;
+    while (written < count) {
+      size_t amount = count - written;
+      error = (*file)->Write(buffer + written, amount);
+      if (error.Fail())
+        return error;
+      if (amount == 0)
+        return Status::FromErrorString("unable to write destination file");
+      written += amount;
+    }
+    offset += count;
+  }
+  error = (*file)->Close();
+  if (error.Fail())
+    return error;
+  close.release();
+  CloseFile(fd, error);
+  return error;
+}
