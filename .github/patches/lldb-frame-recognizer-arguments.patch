 import lldb


+def argument(frame, index):
+    target = frame.GetThread().GetProcess().GetTarget()
+    architecture = target.GetTriple().split("-")[0]
+    if architecture in ("i386", "i486", "i586", "i686"):
+        # These C functions use cdecl: arguments start at the caller's SP.
+        # CFA stays valid at entry and after the callee's prologue.
+        address = frame.GetCFA() + (index - 1) * target.GetAddressByteSize()
+        expression = "*(int *)0x%x" % address
+    else:
+        expression = "$arg%d" % index
+    value = frame.EvaluateExpression(expression)
+    if value.GetError().Fail():
+        raise RuntimeError(value.GetError().GetCString())
+    return value.signed
