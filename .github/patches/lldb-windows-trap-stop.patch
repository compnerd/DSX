diff --git a/lldb/test/API/functionalities/breakpoint/debugbreak/TestDebugBreak.py b/lldb/test/API/functionalities/breakpoint/debugbreak/TestDebugBreak.py
--- a/lldb/test/API/functionalities/breakpoint/debugbreak/TestDebugBreak.py
+++ b/lldb/test/API/functionalities/breakpoint/debugbreak/TestDebugBreak.py
@@ -32,6 +32,15 @@ class DebugBreakTestCase(TestBase):
             else lldb.eStopReasonSignal
         )
         thread = lldbutil.get_stopped_thread(process, stop_reason)
+        if (thread is None and lldb.remote_platform
+                and lldbplatformutil.getPlatform() == "windows"):
+            # A remote Windows stub can encode an embedded trap as RSP SIGTRAP
+            # rather than a native exception. Do not accept an arbitrary signal.
+            thread = lldbutil.get_stopped_thread(process, lldb.eStopReasonSignal)
+            self.assertIsNotNone(thread, "Missing remote breakpoint signal")
+            self.assertEqual(thread.GetStopReasonDataCount(), 1)
+            signal = process.GetUnixSignals().GetSignalNumberFromName("SIGTRAP")
+            self.assertEqual(thread.GetStopReasonDataAtIndex(0), signal)
         self.assertIsNotNone(
             thread, "Unable to find thread stopped at the __debugbreak()"
         )
