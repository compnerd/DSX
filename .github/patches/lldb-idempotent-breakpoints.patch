diff --git a/lldb/test/API/functionalities/multi-breakpoint/TestMultiBreakpoint.py b/lldb/test/API/functionalities/multi-breakpoint/TestMultiBreakpoint.py
--- a/lldb/test/API/functionalities/multi-breakpoint/TestMultiBreakpoint.py
+++ b/lldb/test/API/functionalities/multi-breakpoint/TestMultiBreakpoint.py
@@ -61,8 +61,13 @@
         return f"{addr:x}"
 
     def test_multi_breakpoint(self):
-        # Debugserver uses refcounted breakpoints
-        breakpoints_are_refcounted = self.platformIsDarwin()
+        # Apple's debugserver reference-counts duplicate insertions. That is
+        # an implementation quirk, not a Darwin or RSP requirement.
+        breakpoints_are_refcounted = (
+            self.platformIsDarwin() and not lldbtest_config.out_of_tree_debugserver
+        )
+        # DSX makes both insertion and removal idempotent, as RSP recommends.
+        absent = "OK" if lldbtest_config.out_of_tree_debugserver else "error"
 
         self.build()
         source_file = lldb.SBFileSpec("main.c")
@@ -157,6 +162,6 @@
         reply = self.send_packet(make_packet(array))
         self.assertMultiResponse(
-            reply, ["OK", "OK" if breakpoints_are_refcounted else "error"]
+            reply, ["OK", "OK" if breakpoints_are_refcounted else absent]
         )
 
         # --- Set the same breakpoint twice, but remove it thrice.
@@ -170,6 +175,6 @@
         reply = self.send_packet(make_packet(array))
         self.assertMultiResponse(
-            reply, ["OK", "OK" if breakpoints_are_refcounted else "error", "error"]
+            reply, ["OK", "OK" if breakpoints_are_refcounted else absent, absent]
         )
 
         # --- Set and remove the same address in a single packet ---
@@ -185,11 +190,12 @@
         # --- Remove a breakpoint that was never set ---
         array = [f"z0,{addr_b},{bp_kind}"]
         reply = self.send_packet(make_packet(array))
-        self.assertMultiResponse(reply, ["error"])
+        self.assertMultiResponse(reply, [absent])
 
         # --- A failure in the middle should not prevent later requests from succeeding ---
+        # Malformed input must fail even with idempotent breakpoint removal.
         array = [
             f"Z0,{addr_a},{bp_kind}",
-            f"z0,{addr_b},{bp_kind}",
+            f"Z0,invalid,{bp_kind}",
             f"z0,{addr_a},{bp_kind}",
         ]
