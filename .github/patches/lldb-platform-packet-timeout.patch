diff --git a/lldb/packages/Python/lldbsuite/test/configuration.py b/lldb/packages/Python/lldbsuite/test/configuration.py
--- a/lldb/packages/Python/lldbsuite/test/configuration.py
+++ b/lldb/packages/Python/lldbsuite/test/configuration.py
@@ -67,6 +67,10 @@ dwarf_version = 0
 # Any overridden settings.
 settings = []
 
+# Apply the same transport allowance before platform connection and after
+# each test resets the debugger settings.
+packet_timeout = 60
+
 # Path to the FileCheck testing tool. Not optional.
 filecheck = None
 
diff --git a/lldb/packages/Python/lldbsuite/test/dotest.py b/lldb/packages/Python/lldbsuite/test/dotest.py
--- a/lldb/packages/Python/lldbsuite/test/dotest.py
+++ b/lldb/packages/Python/lldbsuite/test/dotest.py
@@ -1142,5 +1142,16 @@ def run_suite():
             exitTestSuite(1)
         if configuration.lldb_platform_url:
+            # PlatformRemoteGDBServer snapshots the timeout at connection.
+            # TestBase.setUp runs later and cannot update that connection.
+            debugger = lldb.SBDebugger.Create(False)
+            error = lldb.SBDebugger.SetInternalVariable(
+                "plugin.process.gdb-remote.packet-timeout",
+                str(configuration.packet_timeout), debugger.GetInstanceName()
+            )
+            lldb.SBDebugger.Destroy(debugger)
+            if error.Fail():
+                raise RuntimeError(str(error))
+
             # We must connect to a remote platform if a LLDB platform URL was
             # specified
             print(
diff --git a/lldb/packages/Python/lldbsuite/test/lldbtest.py b/lldb/packages/Python/lldbsuite/test/lldbtest.py
