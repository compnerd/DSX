@@ -18,5 +18,35 @@ class ScriptedProcesTestCase(TestBase):
     NO_DEBUG_INFO_TESTCASE = True
 
+    def test_i386_register_info(self):
+        """Scripted threads and native-thread frames share the i386 layout."""
+        from types import SimpleNamespace
+        from lldb.plugins.scripted_process import ScriptedFrame, ScriptedThread
+
+        names = ["eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi",
+                 "eip", "eflags"]
+        roles = {"esp": "sp", "ebp": "fp", "eip": "pc", "eflags": "flags"}
+        layouts = []
+        for cls in (ScriptedThread, ScriptedFrame):
+            state = SimpleNamespace(arch="i386", register_info=None,
+                                    originating_thread=lldb.SBThread())
+            info = cls.get_register_info(state)
+            self.assertIs(cls.get_register_info(state), info)
+            self.assertEqual(info["sets"], ["General Purpose Registers"])
+            registers = info["registers"]
+            self.assertEqual([r["name"] for r in registers], names)
+            for number, register in enumerate(registers):
+                self.assertEqual(register["bitsize"], 32)
+                self.assertEqual(register["offset"], number * 4)
+                self.assertEqual(register["dwarf"], number)
+                self.assertEqual(register["encoding"], "uint")
+                self.assertEqual(register["format"], "hex")
+                self.assertEqual(register["set"], 0)
+                role = roles.get(register["name"])
+                self.assertEqual(register.get("generic"), role)
+                self.assertEqual(register.get("alt-name"), role)
+            layouts.append(info)
+        self.assertEqual(*layouts)
+
