diff --git a/lldb/test/API/commands/frame/var-dil/basics/NoDebugInfo/main.cpp b/lldb/test/API/commands/frame/var-dil/basics/NoDebugInfo/main.cpp
--- a/lldb/test/API/commands/frame/var-dil/basics/NoDebugInfo/main.cpp
+++ b/lldb/test/API/commands/frame/var-dil/basics/NoDebugInfo/main.cpp
@@ -1,3 +1,5 @@
 int foo = 1;

-int main(int argc, char **argv) { return foo; }
+// Keep the entry point available by name without adding debug information.
+// PE images do not otherwise expose an undecorated C entry point on x86.
+LLDB_DYLIB_EXPORT int main(int argc, char **argv) { return foo; }
