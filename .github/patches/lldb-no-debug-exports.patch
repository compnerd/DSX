diff --git a/lldb/test/API/functionalities/multiple-slides/Makefile b/lldb/test/API/functionalities/multiple-slides/Makefile
--- a/lldb/test/API/functionalities/multiple-slides/Makefile
+++ b/lldb/test/API/functionalities/multiple-slides/Makefile
@@ -1,12 +1,12 @@
 C_SOURCES := main.c
 MAKE_DSYM := NO
+# Exercise symbol-only sliding, including the link. Debug information can
+# resolve these globals independently of the addresses being slid.
+MAKE_NO_DEBUG_INFO := YES

-include Makefile.rules
-
-# lldb has a separate bug where this test case
-# does not work if we have debug info - after
-# sliding the binary, the address of `first` and
-# `second` are not slid for some reason on Darwin.
-main.o: main.c
-	$(CC) $(CFLAGS_NO_DEBUG) -c $< -o $@
+ifeq ($(OS),Windows_NT)
+# Clang still requests a PDB with -g0. Use only exported symbols for this test.
+LD_EXTRAS += -Wl,/debug:none
+endif

+include Makefile.rules
diff --git a/lldb/test/API/functionalities/multiple-slides/main.c b/lldb/test/API/functionalities/multiple-slides/main.c
