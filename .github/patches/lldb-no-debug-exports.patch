+++ b/lldb/test/API/functionalities/multiple-slides/main.c
@@ -1,5 +1,5 @@
-int first[2048] = { 5 };
-int second[2048] = { 6 };
+LLDB_DYLIB_EXPORT int first[2048] = { 5 };
+LLDB_DYLIB_EXPORT int second[2048] = { 6 };
 int main()  {
   return first[0] + second[0];
 }
